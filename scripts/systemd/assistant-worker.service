[Unit]
Description=Chiti Assistant — Background worker (scheduler, heartbeat, memory)
After=network.target assistant-backend.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/chiti
ExecStart=/usr/bin/python3 -m backend.worker
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/%i/chiti/data

[Install]
WantedBy=multi-user.target
